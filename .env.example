# Copy this file to .env and adjust for your machine. .env itself is
# gitignored — nothing here is ever committed.
# Directory to scan for source documents (PDFs, DOCX, images). The path
# below is a placeholder — point this at your own document set, it isn't
# a real default.
TM_SOURCE_DIR=C:\path\to\your\technical-manuals

# Directory where extraction results are written.
TM_OUTPUT_DIR=data/extracted

# Meilisearch server. Defaults match `bin/meilisearch.exe --db-path
# data/meilisearch --http-addr 127.0.0.1:7700 --env development` (no auth).
MEILISEARCH_URL=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=
MEILISEARCH_INDEX=documents
# Required if MEILISEARCH_URL isn't localhost and MEILISEARCH_API_KEY is
# unset — set to 1 only if you're intentionally running an unauthenticated
# remote Meilisearch (e.g. a trusted internal network).
# TM_ALLOW_INSECURE_MEILISEARCH=1

# API access control. Unset = the API is open (fine for one dev machine
# only). Set both to require `X-API-Key: <value>` on every /api/* request.
# TM_API_KEY=

# Frontend origins allowed to call the API (comma-separated). Defaults to
# the local Vite dev server.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# /api/search rate limit — requests per client IP per window. 0 disables it.
# TM_SEARCH_RATE_LIMIT=60
# TM_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60

# Extraction safety limits — 0 disables a given limit.
# TM_MAX_PDF_PAGES=2000
# TM_MAX_PDF_FILE_SIZE_MB=500

# --- docker-compose.yml only (ignored by the local/non-Docker setup above) ---
# Meilisearch master key shared by the meilisearch and backend services —
# required, since "meilisearch" is a different container, not localhost,
# so the MEILISEARCH_API_KEY requirement above applies. Generate one with
# `openssl rand -base64 24` or similar.
# MEILI_MASTER_KEY=
# Host path to bind-mount as the backend container's TM_SOURCE_DIR.
# TM_SOURCE_DIR_HOST=./data/source
